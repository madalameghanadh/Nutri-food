<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout android:layout_width="match_parent" android:layout_height="120dp">
            <ImageView
                android:id="@+id/img_food"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
            <TextView
                android:id="@+id/tv_match_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_badge_green"
                android:text="92% AI Match"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:padding="4dp" />
            <ImageView
                android:id="@+id/btn_fav"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:src="@android:drawable/btn_star_big_off"
                android:background="@drawable/bg_fav_btn"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_food_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Food Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/tv_food_diet" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Veg" android:textSize="10sp"
                    android:textColor="@color/primary" android:background="@drawable/bg_chip_green"
                    android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:layout_marginEnd="4dp"/>
                <TextView android:id="@+id/tv_food_cuisine" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Indian" android:textSize="10sp"
                    android:textColor="@color/secondary" android:background="@drawable/bg_chip_blue"
                    android:paddingHorizontal="6dp" android:paddingVertical="2dp"/>
            </LinearLayout>

            <TextView android:id="@+id/tv_food_calories" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="280 kcal" android:textSize="13sp"
                android:textStyle="bold" android:textColor="@color/primary" android:layout_marginTop="6dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/tv_food_protein" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="12g P" android:textSize="10sp"
                    android:textColor="@color/text_muted" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/tv_food_carbs" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="35g C" android:textSize="10sp"
                    android:textColor="@color/text_muted" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/tv_food_fat" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="8g F" android:textSize="10sp"
                    android:textColor="@color/text_muted"/>
            </LinearLayout>

            <TextView android:id="@+id/tv_food_reason" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="" android:textSize="10sp"
                android:textColor="@color/primary" android:layout_marginTop="4dp"
                android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
